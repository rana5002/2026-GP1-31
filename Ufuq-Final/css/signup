body { background: var(--color-cream); }   /* beige page background*/

  :root { --err: #e5646a; --err-text: #cf4a50; --err-bg: #fff6f6; }
  .req { color: var(--err); font-weight: 700; margin-left: 2px; }
  .form-error { color: var(--err-text); font-weight: 500; font-size: .85rem; margin-top: 6px; }
  .form-control.invalid { border: 1.5px solid var(--err) !important; }
  .form-banner {
    background: #fdf1f1; border: 1px solid #f1c0c2; color: var(--err-text);
    font-weight: 500; padding: 10px 14px; border-radius: 8px; margin-bottom: 16px;
  }
  .pw-help { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .pw-help-btn {
    width: 22px; height: 22px; padding: 0; border-radius: 50%; cursor: pointer;
    border: 1.5px solid #9ca3af; background: #fff; color: #6b7280;
    font-weight: 700; font-size: .8rem; line-height: 1;
  }
  .pw-help-btn:hover, .pw-help-btn[aria-expanded="true"] { border-color: var(--color-primary); color: var(--color-primary); }
  .pw-help-label { font-size: .8rem; color: #6b7280; }
  .pw-rules { margin: 8px 0 0; padding-left: 22px; list-style: disc; font-size: .82rem; color: #6b7280; }
  .pw-rules.is-hidden { display: none; }
  .pw-rules li.ok { color: #1a7f37; }
  .gender-option.invalid { border: 1.5px solid var(--err) !important; }
  .gender-option.selected { border-color: var(--color-primary) !important; border-width: 2px !important; }
  .dob-row { display: grid; grid-template-columns: 1fr 1.5fr 1fr; gap: 10px; }
  /* experience / qualification entries */
  .entry-row {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) 36px; gap: 12px; align-items: end;
    border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px; margin-bottom: 12px; background: #fafafa;
  }
  .entry-row:not(.entry-5) { grid-template-columns: minmax(0, 1.5fr) repeat(3, minmax(0, 1fr)) 36px; }
  .entry-row.entry-5 { grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr)) 36px; }

  /* User / Company selector: same plum as the Register button */
  .role-toggle { background: var(--color-soft-bg); }
  .role-toggle button.active { background: var(--color-plum); color: #fff; box-shadow: 0 4px 12px rgba(68, 56, 77, .22); }

  /* optional part (collapsed) */
  .opt-toggle {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; text-align: left;
    padding: 14px 16px; border: 0; border-radius: 12px; background: transparent; cursor: pointer;
    font: inherit; color: inherit;
  }
  /* the optional part is one card with a straight border: header (click to open / close) + the fields */
  .opt-card { margin-top: 8px; border: 1.5px solid var(--color-border); border-radius: 12px; background: #fff; }
  .opt-card:hover, .opt-card:has(.opt-toggle[aria-expanded="true"]) { border-color: var(--color-primary); }
  .opt-toggle .opt-title { display: block; font-weight: 600; }
  .opt-toggle .opt-sub { display: block; font-size: .85rem; color: #6b7280; margin-top: 2px; }
  .opt-toggle .opt-arrow { font-size: 1.2rem; transition: transform .2s; }
  .opt-toggle[aria-expanded="true"] .opt-arrow { transform: rotate(180deg); }
  .opt-box { padding: 18px 16px 6px; border-top: 1.5px solid var(--color-border); }
  /* skills: dropdown + chosen skills as removable chips */
  .chip-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 6px 5px 12px; border-radius: 999px;
    background: #EEE7F1; color: #44384D; font-weight: 600; font-size: .9rem;
  }
  .chip-x {
    width: 22px; height: 22px; padding: 0; border: none; border-radius: 50%; background: rgba(68, 56, 77, .12);
    color: #44384D; font-size: 1rem; line-height: 1; cursor: pointer;
  }
  .chip-x:hover { background: var(--err); color: #fff; }
  .entry-row .form-group { margin-bottom: 0; }
  @media (max-width: 760px) {
    .entry-row, .entry-row.entry-5, .entry-row:not(.entry-5) { grid-template-columns: 1fr 1fr; }
  }
  .entry-remove { align-self: end; height: 40px; border: none; background: transparent; font-size: 1.5rem; line-height: 1; color: #9ca3af; cursor: pointer; }
  .entry-remove:hover { color: var(--err-text); }
 
  .add-entry {
    display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 10px;
    border: 1.5px solid var(--color-border); border-radius: 10px; background: transparent;
    color: #6b7280; font-weight: 600; cursor: pointer;
  }
  .add-entry:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .add-entry .plus { font-size: 1.3rem; line-height: 1; }
  /* header: current-page button looks pressed */
  #site-header a.is-pressed {
    transform: translateY(1px);
    box-shadow: inset 0 3px 8px rgba(0, 0, 0, .28) !important;
    filter: brightness(.92);
  }



  /* searchable drop-down (same look as the dashboards) */
.search-select{position:relative}
.search-select > select{display:none!important}
.search-select-toggle{display:flex!important;align-items:center;justify-content:space-between;gap:8px;width:100%;text-align:left;cursor:pointer;background:#fff}
.search-select-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.search-select-text.is-placeholder{color:#8a8396}
.search-select-caret{flex-shrink:0;color:#8a8396;font-size:.8rem;transition:transform .18s ease}
.search-select.is-open .search-select-caret{transform:rotate(180deg)}
.search-select-panel{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:40;padding:10px;border:1px solid #e5ddef;border-radius:12px;background:#fff;box-shadow:0 12px 30px rgba(40,26,70,.14)}
.search-select-panel[hidden]{display:none!important}
.search-select-list{max-height:210px;margin-top:8px;overflow-y:auto;overscroll-behavior:contain}
.search-select-option{display:flex;align-items:center;gap:9px;padding:8px;border-radius:8px;color:#29243a;font-size:.9rem;line-height:1.5;cursor:pointer;overflow-wrap:anywhere}
.search-select-option:hover,.search-select-option.is-selected{background:#f2ecfa}
.search-select-option.is-selected{color:#281a46;font-weight:650}
.search-select-option[hidden]{display:none!important}
.search-select-empty{padding:10px 8px;color:#8a8396;font-size:.85rem;text-align:center}


/* password eye */
.pw-wrap { position: relative; }
.pw-wrap > input { padding-right: 44px; }
.pw-eye {
  position: absolute; top: 0; right: 0; height: 100%; width: 44px;
  display: flex; align-items: center; justify-content: center;
  background: none; border: 0; cursor: pointer; color: var(--color-text-faint);
}
.pw-eye:hover, .pw-eye:focus-visible { color: var(--color-primary-dark); outline: none; }
.pw-eye svg { width: 20px; height: 20px; }
.pw-eye .eye-off { display: none; }
.pw-eye.shown .eye-on { display: none; }
.pw-eye.shown .eye-off { display: block; }


