/* ===== Ufuq Browse Opportunities ===== */

.user-browse {
    --browse-purple: #39265f;
    --browse-purple-dark: #281a46;
    --browse-purple-mid: #49316f;
    --browse-lavender: #f0ebf8;
    --browse-gold: #e2a94b;
    --browse-bg: #faf6ef;
    --browse-text: #29243a;
    --browse-muted: #777184;
    --browse-border: #e9e3ed;

    min-height: 70vh;
    padding-bottom: 50px;
    background: var(--browse-bg);
    color: var(--browse-text);
}

.user-browse *,
.user-browse *::before,
.user-browse *::after {
    box-sizing: border-box;
}

.user-browse .browse-hero {
    position: relative;
    overflow: hidden;
    padding: 38px 0 42px;
    margin-bottom: 28px;
    color: #fff;
    background: linear-gradient(
        125deg,
        #281a46 0%,
        #39265f 55%,
        #49316f 100%
    );
}

.user-browse .browse-hero::before,
.user-browse .browse-hero::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
}

.user-browse .browse-hero::before {
    width: 250px;
    height: 250px;
    right: 7%;
    top: -150px;
    border: 35px solid rgba(255,255,255,.07);
}

.user-browse .browse-hero::after {
    width: 190px;
    height: 190px;
    right: 23%;
    bottom: -145px;
    background: rgba(226,169,75,.10);
}

.user-browse .browse-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 22px;
}

.user-browse .welcome-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    margin-bottom: 12px;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 30px;
    background: rgba(255,255,255,.08);
    font-size: .84rem;
}

.user-browse .browse-hero h1 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.65rem, 3vw, 2.15rem);
    font-weight: 750;
    line-height: 1.5;
}

.user-browse .browse-hero p {
    margin: 8px 0 0;
    color: rgba(255,255,255,.82);
    font-size: .96rem;
    line-height: 1.8;
}

.user-browse .hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78px;
    height: 78px;
    flex-shrink: 0;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 24px;
    background: rgba(255,255,255,.08);
    box-shadow: 0 10px 28px rgba(15,8,30,.16);
    font-size: 2rem;
    animation: browseFloat 4s ease-in-out infinite;
}

.user-browse .browse-content {
    animation: browseFadeUp .5s ease both;
}

.user-browse .browse-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 18px;
}

.user-browse .section-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 6px;
    color: var(--browse-text);
    font-size: 1.2rem;
    font-weight: 750;
}

.user-browse .section-heading::before {
    content: "";
    width: 5px;
    height: 23px;
    flex-shrink: 0;
    border-radius: 5px;
    background: var(--browse-gold);
}

.user-browse .section-description {
    margin: 0;
    color: var(--browse-muted);
    font-size: .89rem;
    line-height: 1.7;
}

.user-browse .results-count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border: 1px solid #e4dced;
    border-radius: 30px;
    background: #f7f4fb;
    color: var(--browse-purple);
    font-size: .83rem;
    font-weight: 750;
    white-space: nowrap;
}

.user-browse .dashboard-card {
    min-width: 0;
    padding: 21px;
    border: 1px solid var(--browse-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 5px 18px rgba(40,26,70,.045);
    transition: border-color .22s ease, box-shadow .22s ease;
}

.user-browse .search-card {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding: 14px;
}

.user-browse .search-card .form-control {
    flex: 1;
    min-width: 0;
}

.user-browse .search-card .btn {
    min-height: 43px;
    flex-shrink: 0;
}

.user-browse .opportunity-title a {
    color: inherit;
    text-decoration: none;
}

.user-browse .opportunity-title a:hover {
    color: var(--browse-purple);
    text-decoration: underline;
}

.user-browse .filters-card {
    margin-bottom: 24px;
    border-top: 3px solid var(--browse-gold);
    animation: browseFadeUp .35s ease both;
}

.user-browse .filters-card[hidden] {
    display: none !important;
}

.user-browse .filters-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
}

.user-browse .filters-heading h2 {
    margin: 0;
    color: var(--browse-text);
    font-size: 1.1rem;
    font-weight: 750;
}

.user-browse .filter-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}

.user-browse .filter-group {
    min-width: 0;
    padding: 15px;
    border: 1px solid #eee8f3;
    border-radius: 13px;
    background: #fdfcff;
}

.user-browse .filter-group h3 {
    margin: 0 0 13px;
    color: var(--browse-purple);
    font-size: .91rem;
    font-weight: 750;
}

.user-browse .filter-options {
    display: flex;
    flex-direction: column;
    gap: 11px;
}

.user-browse .filter-option {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: #514b5d;
    font-size: .87rem;
    line-height: 1.55;
    cursor: pointer;
    overflow-wrap: anywhere;
}

.user-browse .filter-option input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 3px 0 0;
    accent-color: var(--browse-purple);
    cursor: pointer;
}

.user-browse .form-control {
    width: 100%;
    min-height: 43px;
    padding: 10px 12px;
    border: 1px solid #ddd5e7;
    border-radius: 9px;
    background: #fff;
    color: var(--browse-text);
    font: inherit;
    font-size: .88rem;
}

.user-browse .form-control:focus {
    outline: 3px solid rgba(57,38,95,.12);
    border-color: var(--browse-purple);
}

.user-browse .filter-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
}

.user-browse .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 38px;
    padding: 9px 14px;
    border: 1px solid transparent;
    border-radius: 9px;
    font: inherit;
    font-size: .85rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration: none;
    cursor: pointer;
    transition: transform .18s ease, background .18s ease,
                box-shadow .18s ease, border-color .18s ease;
}

.user-browse .btn:hover {
    transform: translateY(-1px);
}

.user-browse .btn-primary {
    border-color: var(--browse-purple);
    background: var(--browse-purple);
    color: #fff;
    box-shadow: 0 4px 12px rgba(57,38,95,.15);
}

.user-browse .btn-primary:hover {
    border-color: var(--browse-purple-dark);
    background: var(--browse-purple-dark);
    box-shadow: 0 7px 17px rgba(40,26,70,.2);
}

.user-browse .btn-outline {
    border-color: #d9cde8;
    background: #fff;
    color: var(--browse-purple);
}

.user-browse .btn-outline:hover {
    background: var(--browse-lavender);
}

.user-browse .btn-ghost {
    background: transparent;
    color: var(--browse-muted);
}

.user-browse .btn-ghost:hover {
    background: #f5f1f8;
    color: var(--browse-purple);
}

.user-browse .btn-sm {
    min-height: 35px;
    padding: 8px 12px;
    font-size: .82rem;
}

.user-browse .opportunity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 16px;
}

.user-browse .opportunity-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 250px;         /* same height for every card */
    padding: 19px;
    border: 1px solid #ece7f2;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 5px 18px rgba(40,26,70,.045);
    animation: browseFadeUp .45s ease both;
    transition: transform .22s ease, box-shadow .22s ease,
                border-color .22s ease;
}

.user-browse .opportunity-card:hover {
    transform: translateY(-3px);
    border-color: #cfc1e2;
    box-shadow: 0 12px 28px rgba(40,26,70,.1);
}

.user-browse .opportunity-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 15px;
}

.user-browse .company-info {
    display: flex;
    align-items: flex-start;   /* logo and title start on the same line */
    gap: 11px;
    min-width: 0;
}

.user-browse .company-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--browse-lavender);
    color: var(--browse-purple);
    font-size: 1.15rem;
    font-weight: 800;
}

.user-browse .company-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
}

.user-browse .company-details {
    min-width: 0;
}

.user-browse .opportunity-title {
    margin: 0;
    min-height: calc(2 * 1.55em);   /* at least 2 lines, so the company name below lines up across cards */
    color: var(--browse-text);
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.55;
    overflow-wrap: anywhere;
    /* Shown in full; it sits under the company row, so long titles don't move anything above it. */
}

.user-browse .company-name {
    margin: auto 0 8px;        /* sits right above the type row, at the bottom of the card */
    padding: 0 0 0 11px;       /* starts where the text inside the type button starts (1px border + 10px padding) */
    text-align: left;
    color: var(--browse-muted);
    font-weight: 400;          /* regular weight, lighter than the title */
    font-size: .86rem;
    line-height: 1.55;
    overflow-wrap: anywhere;
}

.user-browse .favorite-form {
    flex-shrink: 0;
    margin: 0;
}

.user-browse .favorite-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    padding: 0;
    border: 1px solid #e9e3ed;
    border-radius: 11px;
    background: #fff;
    color: #777184;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    transition: transform .18s ease, background .18s ease,
                border-color .18s ease;
}

.user-browse .favorite-button:hover {
    transform: translateY(-1px);
    border-color: #e5b9c1;
    background: #fff6f7;
}

.user-browse .favorite-button.is-favorite {
    border-color: #f1d4d8;
    background: #fff1f2;
    color: #bd334d;
}

.user-browse .opportunity-description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 17px;
    color: #625b6d;
    font-size: .87rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
}

.user-browse .opportunity-meta {
    display: flex;
    justify-content: flex-start;
    padding: 0;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 17px;
    color: var(--browse-muted);
    font-size: .81rem;
    line-height: 1.6;
}

.user-browse .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px;
    border-radius: 30px;
    font-size: .76rem;
    font-weight: 750;
    white-space: normal;
    overflow-wrap: anywhere;
}

.user-browse .badge-course,
.user-browse .badge-program {
    margin-left: 0;
    /* Type is information, not a state: one calm neutral style for every type,
       so colour is kept only for the status (Open / Upcoming / Closed). */
    border: 1px solid #e7e0ef;
    background: transparent;   /* outline only: lighter than the status, which keeps its soft colour */
    color: #5b4a7a;
    font-weight: 650;
}

.user-browse .badge-open {
    background: #e8f5ec;
    color: #24653c;
}

.user-browse .badge-closed {
    border: 1px solid #f1d4d8;
    background: #fff1f2;
    color: #9c263d;
}

.user-browse .badge-other {
    background: #fff5e4;
    color: #80521b;
}

/* Upcoming: applications not open yet (grey) */
.user-browse .badge-upcoming {
    border: 1px solid #e3e0e8;
    background: #f3f2f5;
    color: #5f5a6b;
}

/* Card footer: status on the left, View Details on the right */
.user-browse .opportunity-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 15px;
    border-top: 1px solid #f0edf4;
}

.user-browse .opportunity-footer .badge {
    min-width: 96px;           /* Open / Upcoming / Closed: same size */
    gap: 7px;
    padding: 5px 12px;
    font-size: .78rem;
    border: 1px solid transparent;
}

/* Type (top) and status (bottom): exactly the same size */
.user-browse .opportunity-meta .badge,
.user-browse .opportunity-footer .badge {
    box-sizing: border-box;
    min-width: 96px;
    height: 30px;
    padding: 0 12px;
    border-width: 1px;
    border-style: solid;
    font-size: .78rem;
    line-height: 1;
    white-space: nowrap;
}

/* Small dot in the status colour, so the state reads at a glance without a loud fill */
.user-browse .opportunity-footer .badge::before {
    content: "";
    width: 7px;
    height: 7px;
    flex-shrink: 0;
    border-radius: 50%;
    background: currentColor;
}

.user-browse .opportunity-footer .badge-open {
    border-color: #cfe8d9;
}

.user-browse .opportunity-footer .badge-closed {
    border-color: #f1d4d8;
}

.user-browse .opportunity-footer .badge-upcoming {
    border-color: #e3e0e8;
}



.user-browse .empty-state {
    padding: 40px 20px;
    border: 1px dashed #d8cde7;
    border-radius: 16px;
    background: #fbf9fd;
    text-align: center;
    animation: browseFadeUp .4s ease both;
}

.user-browse .empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    margin-bottom: 13px;
    border-radius: 21px;
    background: var(--browse-lavender);
    color: var(--browse-purple);
    font-size: 1.8rem;
}

.user-browse .empty-state h2 {
    margin: 0;
    color: var(--browse-text);
    font-size: 1.08rem;
    font-weight: 750;
}

.user-browse .empty-state p {
    margin: 8px 0 0;
    color: var(--browse-muted);
    font-size: .89rem;
    line-height: 1.8;
}

.user-browse .dashboard-notice {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 13px 16px;
    margin-bottom: 20px;
    border: 1px solid #e4dced;
    border-radius: 13px;
    background: #f7f4fb;
    color: var(--browse-purple);
    font-size: .9rem;
    line-height: 1.65;
}

.user-browse .dashboard-notice.notice-warning {
    border-color: #f0d6b0;
    background: #fff8ed;
    color: #80521b;
}

.user-browse .dashboard-notice.notice-error {
    border-color: #f1d4d8;
    background: #fff4f5;
    color: #9c263d;
}

/* Toast: success message that slides down from the top, then disappears */
.browse-toast {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 11px;
    width: max-content;
    max-width: calc(100% - 32px);
    padding: 13px 14px 13px 16px;
    border: 1px solid #bfe3cc;
    border-radius: 13px;
    background: #eaf7ef;
    color: #1f6b47;
    font-size: .92rem;
    font-weight: 700;
    line-height: 1.5;
    box-shadow: 0 12px 30px rgba(31,107,71,.16);
    transform: translate(-50%, -150%);
    opacity: 0;
    transition: transform .35s ease, opacity .35s ease;
}

.browse-toast.is-shown {
    transform: translate(-50%, 0);
    opacity: 1;
}

.browse-toast-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #2f8a5c;
    color: #fff;
    font-size: .85rem;
}

.browse-toast-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: #1f6b47;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
}

.browse-toast-close:hover {
    background: rgba(31,107,71,.1);
}

@media (prefers-reduced-motion: reduce) {
    .browse-toast { transition: none; }
}

@keyframes browseFadeUp {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes browseFloat {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-5px);
    }
}

/* ===== Searchable multi-select dropdowns ===== */
.user-browse .multi-dropdown {
    position: relative;
}

.user-browse .multi-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    text-align: left;
    cursor: pointer;
}

.user-browse .multi-dropdown-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.user-browse .multi-dropdown-label.is-placeholder {
    color: var(--browse-muted);
}

.user-browse .multi-dropdown-caret {
    flex-shrink: 0;
    color: var(--browse-muted);
    font-size: .8rem;
    transition: transform .18s ease;
}

.user-browse .multi-dropdown.is-open .multi-dropdown-caret {
    transform: rotate(180deg);
}

.user-browse .multi-dropdown-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 30;
    padding: 10px;
    border: 1px solid var(--browse-border);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(40,26,70,.14);
}

.user-browse .multi-dropdown-panel[hidden] {
    display: none !important;
}

.user-browse .multi-dropdown-list {
    max-height: 210px;
    margin-top: 8px;
    overflow-y: auto;
}

.user-browse .multi-dropdown-option {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 8px 8px;
    border-radius: 8px;
    color: #514b5d;
    font-size: .87rem;
    line-height: 1.5;
    cursor: pointer;
    overflow-wrap: anywhere;
}

.user-browse .multi-dropdown-option:hover {
    background: var(--browse-lavender);
}

.user-browse .multi-dropdown-option[hidden] {
    display: none !important;
}

.user-browse .multi-dropdown-option input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 3px 0 0;
    accent-color: var(--browse-purple);
    cursor: pointer;
}

.user-browse .multi-dropdown-empty {
    padding: 10px 8px;
    color: var(--browse-muted);
    font-size: .85rem;
    text-align: center;
}

/* ===== Filter sidebar on the left (same idea as the company "Filter Applicants") ===== */
.user-browse .browse-filter-bar {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 10px;
}

.user-browse .filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}


/* Sort button + menu (next to the Filters button) */
.user-browse .sort-wrap { position: relative; flex-shrink: 0; }
.user-browse .sort-toggle { display: inline-flex; align-items: center; gap: 8px; }
.user-browse .sort-toggle[aria-expanded="true"],
.user-browse .sort-toggle.is-active { background: var(--browse-lavender); }
.user-browse .sort-menu {
    position: absolute; top: calc(100% + 8px); left: 0; z-index: 50; width: 250px; padding: 10px;
    border: 1px solid #e5ddef; border-radius: 14px; background: #fff; box-shadow: 0 12px 30px rgba(40, 26, 70, .16);
}
.user-browse .sort-menu[hidden] { display: none; }
.user-browse .sort-menu-title { margin: 6px 8px 4px; font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: #8a8396; }
.user-browse .sort-menu-line { margin: 6px 0; border-top: 1px solid #eee7f6; }
.user-browse .sort-option { display: flex; align-items: center; gap: 10px; padding: 9px 8px; border-radius: 9px; cursor: pointer; font-size: .92rem; color: #29243a; }
.user-browse .sort-option:hover { background: var(--browse-lavender); }
.user-browse .sort-option input { width: 16px; height: 16px; margin: 0; accent-color: #39265f; }



/* Filters button: same color as when you hover on it, while the filter card is open */
.user-browse .filter-toggle[aria-expanded="true"] {
    background: var(--browse-lavender);
}


.user-browse .filter-toggle-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--browse-gold);
    color: #fff;
    font-size: .74rem;
    font-weight: 800;
}

.user-browse .browse-layout {
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
}

.user-browse .browse-layout.filters-hidden {
    grid-template-columns: minmax(0, 1fr);
}

.user-browse .browse-layout.filters-hidden .filter-panel {
    display: none;
}

.user-browse .browse-results {
    min-width: 0;
}

/* Only the filter moves left, into the empty space beside the page; the opportunity cards stay in place. */
.user-browse .browse-content {
    --filter-shift: min(312px, max(0px, calc((100vw - 100%) / 2 - 16px)));
}

.user-browse .browse-layout {
    margin-left: calc(-1 * var(--filter-shift));
}

.user-browse .browse-layout.filters-hidden {
    margin-left: 0;
}

.user-browse .filter-panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 18px;
    background: #fff;
    border: 1px solid var(--browse-border);
    border-radius: 16px;
    box-shadow: 0 5px 18px rgba(40,26,70,.045);
    animation: browseFadeUp .3s ease both;
}

.user-browse .filter-panel-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee8f4;
    color: var(--browse-text);
    font-size: 1rem;
    font-weight: 750;
}

.user-browse .filter-panel-title::before {
    content: "";
    display: block;
    width: 5px;
    height: 20px;
    border-radius: 5px;
    background: var(--browse-gold);
}

.user-browse .filter-field {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
}

.user-browse .filter-field > label,
.user-browse .filter-label {
    color: var(--browse-text);
    font-size: .86rem;
    font-weight: 700;
}

.user-browse .filter-field .form-control {
    min-height: 42px;
    padding: 9px 11px;
}

.user-browse .filter-panel-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.user-browse .filter-panel-actions .btn {
    flex: 1;
}



/* Category header with a triangle that opens / closes its list */
.user-browse .lookup-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 4px 2px;
    border: 0;
    border-radius: 8px;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
}

.user-browse .lookup-header:hover .filter-label {
    color: var(--browse-purple);
}

.user-browse .lookup-header:focus-visible {
    outline: 2px solid var(--browse-purple);
    outline-offset: 2px;
}

.user-browse .lookup-caret {
    flex-shrink: 0;
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid var(--browse-purple);
    transition: transform .2s ease;
}

.user-browse .lookup-field.is-open .lookup-caret {
    transform: rotate(180deg);
}

.user-browse .lookup-box[hidden] {
    display: none !important;
}

/* Checkbox list box with search: shows 5 items, scroll for the rest */
.user-browse .lookup-count {
    color: var(--browse-purple);
    font-size: .8rem;
    font-weight: 650;
}

.user-browse .lookup-box {
    padding: 8px;
    border: 1px solid #ddd5e8;
    border-radius: 10px;
    background: #fff;
    animation: browseFadeUp .2s ease both;
}

.user-browse .lookup-box:focus-within {
    border-color: var(--browse-purple);
    box-shadow: 0 0 0 3px rgba(57,38,95,.10);
}

.user-browse .lookup-box .lookup-search {
    min-height: 36px;
    padding: 7px 10px;
    font-size: .85rem;
}

.user-browse .lookup-list {
    max-height: 180px;
    margin-top: 6px;
    overflow-y: auto;
    overscroll-behavior: contain;
}

.user-browse .lookup-list.no-search {
    margin-top: 0;
}

.user-browse .lookup-option {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 36px;
    padding: 6px 8px;
    border-radius: 8px;
    color: #514b5d;
    font-size: .87rem;
    line-height: 1.4;
    cursor: pointer;
    overflow-wrap: anywhere;
}

.user-browse .lookup-option:hover {
    background: var(--browse-lavender);
}

.user-browse .lookup-option:has(input:checked) {
    background: #f2ecfa;
    color: var(--browse-purple-dark);
    font-weight: 650;
}

.user-browse .lookup-option[hidden] {
    display: none !important;
}

.user-browse .lookup-option input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin: 0;
    accent-color: var(--browse-purple);
    cursor: pointer;
}

.user-browse .lookup-empty {
    padding: 10px 8px;
    color: var(--browse-muted);
    font-size: .85rem;
    text-align: center;
}

/* With the filter open: always 3 cards per row on wide screens (even when the page is zoomed out),
   so the opportunities line up with the 3 company cards above. */
.user-browse .browse-layout:not(.filters-hidden) .opportunity-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}
@media (max-width: 1100px) {
    .user-browse .browse-layout:not(.filters-hidden) .opportunity-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}
@media (max-width: 620px) {
    .user-browse .browse-layout:not(.filters-hidden) .opportunity-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 900px) {
    .user-browse .browse-layout {
        grid-template-columns: minmax(0, 1fr);
    }

    .user-browse .browse-layout {
        margin-left: 0;
    }
}

@media (max-width: 950px) {
    .user-browse .opportunity-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .user-browse .filter-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 620px) {
    .user-browse .browse-hero {
        padding: 30px 0;
    }

    .user-browse .hero-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        font-size: 1.6rem;
    }

    .user-browse .opportunity-grid,
    .user-browse .filter-grid {
        grid-template-columns: 1fr;
    }

    .user-browse .dashboard-card {
        padding: 16px;
    }

    .user-browse .opportunity-card {
        padding: 16px;
    }

    .user-browse .browse-toolbar {
        align-items: flex-start;
    }
}

@media (prefers-reduced-motion: reduce) {
    .user-browse *,
    .user-browse *::before,
    .user-browse *::after {
        animation: none !important;
        transition: none !important;
        scroll-behavior: auto !important;
    }
}

/* Companies on Ufuq: collapsible panel above the opportunities */
.user-browse .companies-panel {
    /* No outer box: same width as the opportunities below, so the company cards line up with them */
    margin: 0 0 30px;
}
.user-browse .companies-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    cursor: pointer;
}
.user-browse .companies-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid var(--browse-border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
}
.user-browse .companies-toggle:hover {
    background: var(--browse-lavender);
}
.user-browse .companies-toggle:focus-visible {
    outline: 2px solid var(--browse-purple);
    outline-offset: 4px;
    border-radius: 8px;
}
.user-browse .companies-sub {
    margin-top: 4px;
}
.user-browse .companies-panel .companies-body {
    /* One horizontal row: each company card is exactly as wide as an opportunity card (3 per row);
       more companies scroll sideways instead of making the page longer. */
    display: grid;
    grid-auto-flow: column;
    grid-template-columns: none;
    grid-auto-columns: calc((100% - 2 * 18px) / 3);
    gap: 18px;
    margin-top: 14px;
    padding: 4px 0 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
}
/* Company card: same white card, border, radius, shadow and hover as the opportunity cards */
.user-browse .company-tile {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 16px;
    border: 1px solid #ece7f2;
    border-radius: 16px;
    background: #fff;
    color: var(--browse-text);
    text-decoration: none;
    box-shadow: 0 5px 18px rgba(40,26,70,.045);
    scroll-snap-align: start;
    transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}
.user-browse .company-tile:hover {
    transform: translateY(-3px);
    border-color: #cfc1e2;
    box-shadow: 0 12px 28px rgba(40,26,70,.1);
}
.user-browse .company-tile-text {
    flex: 1;
    min-width: 0;
}
.user-browse .company-tile-name {
    margin: 0;
    color: var(--browse-text);
    font-size: .95rem;
    font-weight: 750;
    line-height: 1.45;
    overflow-wrap: anywhere;   /* full name and sector, no … */
}
.user-browse .company-tile-meta {
    color: var(--browse-muted);   /* same as the company name on the opportunity cards */
    font-size: .86rem;
    line-height: 1.55;
    overflow-wrap: anywhere;   /* full name and sector, no … */
}
.user-browse .company-tile-link {
    flex-shrink: 0;
    color: var(--browse-purple);
    font-size: .82rem;
    font-weight: 700;
    white-space: nowrap;
}
.user-browse .company-tile-btn {
    flex-shrink: 0;           /* purple button, same colour as "View Details", a little smaller */
    padding: 7px 10px;
    min-height: 34px;
    font-size: .78rem;
    white-space: nowrap;
}
/* slightly smaller logo box here, so the full name and sector fit on one line */
.user-browse .company-tile .company-logo {
    width: 42px;
    height: 42px;
    border-radius: 12px;
}
@media (max-width: 950px) {
    .user-browse .companies-panel .companies-body { grid-auto-columns: calc((100% - 18px) / 2); }
}
@media (max-width: 620px) {
    .user-browse .companies-panel .companies-body { grid-auto-columns: 85%; }
}
.user-browse .companies-caret {
    flex-shrink: 0;
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 8px solid var(--browse-purple);
    transition: transform .2s ease;
}
.user-browse .companies-toggle[aria-expanded="true"] .companies-caret {
    transform: rotate(180deg);
}
.user-browse .companies-body[hidden],
.user-browse .collapse-body[hidden] {
    display: none !important;
}
.user-browse .section-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}
.user-browse .collapse-body {
    animation: browseFadeUp .25s ease both;
}
.user-browse .companies-body {
    animation: browseFadeUp .25s ease both;
}

/* Company profile search results */
.user-browse .company-search-results {
    margin: 0 0 24px;
}
.user-browse .company-search-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
    margin-top: 13px;
}
.user-browse .company-search-card {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    padding: 15px;
    border: 1px solid #e2d7ec;
    border-radius: 14px;
    background: linear-gradient(135deg, #fff 0%, #f3edf8 100%);
    color: var(--browse-text);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(40,26,70,.05);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
}
.user-browse .company-search-card:hover {
    transform: translateY(-3px);
    border-color: #bba8d1;
    box-shadow: 0 10px 22px rgba(40,26,70,.11);
}
.user-browse .company-search-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 13px;
    background: #e5d9f0;
    color: var(--browse-purple);
    font-weight: 800;
    font-size: 1.1rem;
}
.user-browse .company-search-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}
.user-browse .company-search-name {
    display: block;
    color: var(--browse-purple);
    font-weight: 800;
    overflow-wrap: anywhere;
}
.user-browse .company-search-meta {
    display: block;
    margin-top: 3px;
    color: var(--browse-muted);
    font-size: .8rem;
}
.user-browse .company-search-arrow {
    margin-left: auto;
    color: #8e789f;
    font-size: 1.15rem;
}
