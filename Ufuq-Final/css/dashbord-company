/* Opportunity review cards on the company dashboard. */
.company-dashboard .opportunity-review-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.company-dashboard .opportunity-review-card {
    min-width: 0;
    border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-gold);
    border-radius: 16px;
    padding: 20px;
    background: #fff;
}

.company-dashboard .opportunity-review-card h3 {
    margin: 0 0 12px;
    color: var(--c-text);
    font-size: 1rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
}

.company-dashboard .opportunity-review-average {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 14px;
}

.company-dashboard .review-star {
    color: #d99a2b;
    font-size: 1.25rem;
}

.company-dashboard .opportunity-review-comment {
    margin-top: 12px;
    padding: 13px;
    border: 1px solid var(--c-border);
    border-radius: 12px;
    background: #faf7f1;
}

.company-dashboard .opportunity-review-comment-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
}

.company-dashboard .opportunity-review-comment p {
    margin: 8px 0;
    color: var(--c-text);
    font-size: .9rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.company-dashboard .opportunity-review-comment small {
    color: var(--c-muted);
}

.company-dashboard .opportunity-review-link {
    margin-top: 15px;
}

/* Close opportunity confirmation modal */
.close-confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(31, 47, 70, 0.65);
}

.close-confirm-modal {
    width: 100%;
    max-width: 480px;
    padding: 30px;
    border-radius: 16px;
    background: #f5f2ec;
    color: #1f2f46;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    text-align: center;
}

.close-confirm-modal h2 {
    margin-top: 0;
    color: #1f2f46;
}

.close-warning {
    margin: 18px 0;
    color: #b42318;
    font-weight: 600;
    line-height: 1.7;
}

.close-confirm-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
}

.close-confirm-actions form {
    margin: 0;
}

.close-confirm-submit {
    border: none;
    background: #b42318;
    color: #fff;
    cursor: pointer;
    padding: 10px 16px;
    border-radius: 8px;
}

.close-confirm-submit:hover {
    background: #8f1c13;
}


@media (max-width: 700px) {
    .company-dashboard .opportunity-review-grid {
        grid-template-columns: minmax(0, 1fr);
    }
}
@keyframes companyFadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes companyFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
